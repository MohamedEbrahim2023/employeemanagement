# ============================================================================
# Public Browser-Safe Configuration (Safe to expose via NEXT_PUBLIC_ prefix)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Server-Only Configuration & Secrets (NEVER prefix secret keys with NEXT_PUBLIC_)
# ============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional: Initial Administrator CLI Provisioning (`npm run provision:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Tariq Al-Mansoor"
ORG_NAME="Nukhba Enterprise Holding"
ORG_SLUG="nukhba-enterprise"
