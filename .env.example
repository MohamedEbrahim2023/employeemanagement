# ============================================================================
# Public Browser-Safe Configuration (Safe to expose via NEXT_PUBLIC_ prefix)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-placeholder
